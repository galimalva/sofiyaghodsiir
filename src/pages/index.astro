---
// وب‌سایت اختصاصی محدثه قدسی - رفع مشکل صدای تایپ
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>محدثه قدسی | روایتگر مینیاتور و قصه</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gulzar&family=Vazirmatn:wght@300;400;700;900&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --navy-deep: #050E1A;
        --navy-primary: #0A1828;
        --navy-card: #0F2340;
        --burgundy: #5A1422;
        --burgundy-glow: #8A2D48;
        --emerald: #0E5C45;
        --emerald-glow: #15A199;
        --gold-dusty: #BC9A5A;
        --ivory: #E6DFD0;
        --text-muted: #8A8B92;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Vazirmatn', sans-serif;
        background-color: var(--navy-deep);
        color: var(--ivory);
        line-height: 2;
        overflow-x: hidden;
      }

      .calligraphic { font-family: 'Gulzar', serif; font-weight: 400; }

      /* لایه ورود (Intro) */
      .intro-overlay {
        position: fixed; inset: 0; z-index: 1000; background: var(--navy-deep);
        display: flex; align-items: center; justify-content: center; 
        transition: opacity 1s ease, visibility 1s ease;
      }
      .intro-overlay.hidden { opacity: 0; visibility: hidden; }
      .intro-bg-img {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        object-fit: cover; object-position: center; 
        filter: grayscale(20%) brightness(0.25) blur(2px);
        z-index: 1;
      }
      .intro-dark-layer {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: radial-gradient(circle, rgba(5, 14, 26, 0.4) 0%, rgba(5, 14, 26, 0.9) 100%);
        z-index: 2;
      }
      .intro-content {
        position: relative; z-index: 3;
        display: flex; flex-direction: column; align-items: center; gap: 2rem;
        text-align: center; padding: 2rem; max-width: 90%;
      }
      .shahnameh-poem { max-width: 600px; font-size: 1.8rem; color: var(--ivory); line-height: 1.8; text-shadow: 0 2px 10px rgba(0,0,0,0.8); }
      .enter-btn { padding: 1rem 3rem; background: transparent; border: 1px solid var(--gold-dusty); color: var(--gold-dusty); font-family: 'Vazirmatn'; font-size: 1rem; cursor: pointer; transition: all 0.4s; text-shadow: 0 2px 5px rgba(0,0,0,0.5); }
      .enter-btn:hover { background: rgba(188, 154, 90, 0.15); box-shadow: 0 0 20px rgba(188, 154, 90, 0.4); }

      /* هدر شناور */
      .glass-header {
        position: fixed; top: 1.5rem; left: 50%; transform: translateX(-50%); z-index: 100; padding: 1rem 2.5rem;
        background: rgba(10, 24, 40, 0.7); backdrop-filter: blur(15px);
        border: 1px solid rgba(188, 154, 90, 0.2); border-radius: 4px; 
        display: flex; align-items: center; justify-content: space-between; gap: 3rem; width: calc(100% - 4rem); max-width: 900px;
      }
      .nav-links { display: flex; gap: 2rem; }
      .nav-links a { color: var(--text-muted); font-size: 0.9rem; text-decoration: none; transition: color 0.3s; position: relative; }
      .nav-links a:hover { color: var(--burgundy-glow); }
      .nav-links a::after { content: ''; position: absolute; bottom: -5px; right: 0; width: 0; height: 1px; background: var(--gold-dusty); transition: width 0.3s; }
      .nav-links a:hover::after { width: 100%; }

      /* هیرو */
      .hero { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 0 2rem; position: relative; }
      .hero-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.4; z-index: 1; }
      .hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, var(--navy-deep) 0%, transparent 40%, var(--navy-deep) 100%); z-index: 2; }
      .hero-content { position: relative; z-index: 3; text-align: center; }
      .hero-title { font-size: 5rem; margin-bottom: 1rem; background: linear-gradient(180deg, var(--ivory), var(--gold-dusty)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; border-right: 2px solid var(--gold-dusty); padding-right: 1rem; white-space: nowrap; overflow: hidden; min-height: 80px; display: inline-block; }
      .hero-title::after { content: '|'; color: var(--gold-dusty); animation: blink 0.8s infinite; }
      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
      .hero-sub { display: flex; flex-direction: column; gap: 0.3rem; min-height: 5rem; }
      .hero-sub div { letter-spacing: 5px; color: var(--burgundy-glow); font-size: 1rem; white-space: nowrap; overflow: hidden; min-height: 1.5rem; }

      /* بخش عمومی */
      .section { padding: 6rem 2rem; position: relative; max-width: 1200px; margin: 0 auto; }
      .section-title { font-size: 3.5rem; text-align: center; margin-bottom: 1rem; color: var(--ivory); }
      .section-line { width: 80px; height: 2px; margin: 0 auto 4rem; background: var(--gold-dusty); position: relative; }
      .section-line::before, .section-line::after { content: '✦'; position: absolute; top: -12px; color: var(--gold-dusty); font-size: 0.8rem; }
      .section-line::before { right: -20px; }
      .section-line::after { left: -20px; }

      /* قاب مینیاتوری دور کارت‌ها */
      .miniature-frame { position: relative; background: rgba(15, 35, 64, 0.6); border: 1px solid rgba(188, 154, 90, 0.1); transition: border-color 0.4s; }
      .miniature-frame:hover { border-color: rgba(201, 169, 93, 0.2); }
      .miniature-frame::before { content: ''; position: absolute; top: 10px; right: 10px; width: 30px; height: 30px; border-top: 2px solid var(--gold-dusty); border-right: 2px solid var(--gold-dusty); transition: 0.3s; }
      .miniature-frame::after { content: ''; position: absolute; bottom: 10px; left: 10px; width: 30px; height: 30px; border-bottom: 2px solid var(--gold-dusty); border-left: 2px solid var(--gold-dusty); transition: 0.3s; }
      
      /* آثار و منوی شناور */
      .works-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
      .work-card { padding: 3rem 2rem; text-align: center; cursor: pointer; position: relative; }
      .work-icon-svg { width: 48px; height: 48px; color: var(--gold-dusty); margin: 0 auto 1.5rem; display: block; transition: transform 0.3s; }
      .work-card:hover .work-icon-svg { transform: scale(1.1); }
      .work-title { font-size: 1.8rem; color: var(--ivory); margin-bottom: 0.5rem; }
      .work-genre { color: var(--emerald-glow); font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 1.5rem; display: block; }
      
      .works-list {
        position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(10px);
        background-color: var(--navy-primary); border: 1px solid var(--gold-dusty);
        border-radius: 4px; box-shadow: 0 8px 16px rgba(0,0,0,0.4); z-index: 20;
        min-width: 180px; padding: 0.5rem 0; text-align: right;
        opacity: 0; visibility: hidden; transition: all 0.3s ease;
      }
      .work-card:hover .works-list { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
      .works-list a { color: var(--text-muted); text-decoration: none; transition: background 0.2s, color 0.2s; font-size: 0.95rem; display: block; padding: 0.5rem 1.5rem; }
      .works-list a:hover { background-color: rgba(188, 154, 90, 0.1); color: var(--ivory); }

      /* دلنوشته‌ها */
      .excerpts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
      .excerpt-card { position: relative; background: rgba(255, 255, 255, 0.02); padding: 3rem 2.5rem; border-right: 1px solid var(--burgundy-glow); overflow: hidden; transition: all 0.4s ease; }
      .excerpt-card:hover { background: rgba(255, 255, 255, 0.04); transform: scale(1.02); }
      .excerpt-quote { position: absolute; top: -20px; left: 20px; font-size: 6rem; color: var(--burgundy); opacity: 0.1; font-family: serif; pointer-events: none; }
      .excerpt-text { font-size: 1.1rem; color: var(--ivory); font-weight: 300; font-style: italic; text-align: justify; margin-bottom: 2rem; }
      .excerpt-signature { text-align: left; color: var(--gold-dusty); font-size: 0.9rem; border-top: 1px solid rgba(188, 154, 90, 0.2); padding-top: 1rem; text-decoration: none; display: block; transition: color 0.3s; }
      .excerpt-signature:hover { color: var(--emerald-glow); }

      /* گالری و لایت‌باکس */
      .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
      .gallery-item { aspect-ratio: 1; background: var(--navy-card); border: 1px solid rgba(188, 154, 90, 0.1); cursor: pointer; transition: 0.3s; overflow: hidden; position: relative; }
      .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
      .gallery-item:hover { border-color: var(--burgundy-glow); box-shadow: 0 0 15px rgba(90, 20, 34, 0.3); }
      .gallery-item:hover img { transform: scale(1.1); }
      
      .lightbox-overlay {
        position: fixed; z-index: 2000; inset: 0; background: rgba(5, 14, 26, 0.95); backdrop-filter: blur(10px);
        display: flex; align-items: center; justify-content: center; padding: 2rem;
        opacity: 0; visibility: hidden; transition: opacity 0.4s ease, visibility 0.4s ease;
      }
      .lightbox-overlay.open { opacity: 1; visibility: visible; }
      .lightbox-content {
        max-width: 80%; max-height: 80vh; border: 2px solid var(--gold-dusty); padding: 10px; background: var(--navy-deep);
        transform: scale(0.8); transition: transform 0.4s ease;
      }
      .lightbox-overlay.open .lightbox-content { transform: scale(1); }
      .lightbox-content img { width: 100%; height: 100%; object-fit: contain; }
      .close-btn {
        position: absolute; top: 30px; left: 40px; color: var(--gold-dusty); font-size: 3rem; cursor: pointer; transition: 0.3s; background: none; border: none;
      }
      .close-btn:hover { color: var(--burgundy-glow); transform: rotate(90deg); }

      /* پژواک خوانندگان (نظرات) */
      .reviews-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
      .review-card { position: relative; background: rgba(255, 255, 255, 0.03); padding: 2.5rem; border-left: 1px solid var(--gold-dusty); border-radius: 8px; overflow: hidden; transition: all 0.4s ease; }
      .review-card:hover { background: rgba(255, 255, 255, 0.05); transform: translateY(-5px); }
      .review-card::before { content: '”'; position: absolute; top: -10px; left: 10px; font-size: 6rem; color: var(--burgundy); opacity: 0.15; font-family: serif; pointer-events: none; }
      .review-text { font-size: 1.1rem; color: var(--ivory); font-weight: 300; font-style: italic; text-align: justify; margin-bottom: 2rem; position: relative; z-index: 2; }
      .reviewer-info { display: flex; align-items: center; gap: 1rem; }
      .reviewer-avatar { width: 45px; height: 45px; border-radius: 50%; background: var(--navy-card); border: 1px solid var(--gold-dusty); display: flex; align-items: center; justify-content: center; color: var(--gold-dusty); font-size: 1rem; font-weight: 700; flex-shrink: 0; }
      .reviewer-name { color: var(--ivory); font-size: 1rem; font-weight: 700; }
      .reviewer-role { color: var(--text-muted); font-size: 0.8rem; }

      /* درباره من */
      .about-box { display: flex; align-items: center; gap: 4rem; }
      .about-text { flex: 1; }
      .about-img { flex: 0 0 300px; height: 400px; border: 2px solid var(--gold-dusty); padding: 10px; position: relative; }
      .about-img img { width: 100%; height: 100%; object-fit: cover; }

      /* انیمیشن Reveal */
      .reveal { opacity: 0; transform: translateY(40px); transition: all 1s ease; }
      .reveal.visible { opacity: 1; transform: translateY(0); }

      /* فوتر */
      footer { margin-top: 4rem; padding: 3rem 2rem; border-top: 1px solid rgba(188, 154, 90, 0.1); text-align: center; }
      
      /* آیکون همبرگر موبایل */
      .hamburger-btn { display: none; background: none; border: none; cursor: pointer; flex-direction: column; gap: 5px; }
      .hamburger-btn span { width: 25px; height: 2px; background: var(--ivory); }
      .mobile-menu { position: fixed; inset: 0; background: var(--navy-deep); z-index: 90; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rem; opacity: 0; pointer-events: none; transition: 0.4s; }
      .mobile-menu.open { opacity: 1; pointer-events: all; }
      .mobile-menu a { color: var(--ivory); font-size: 1.5rem; text-decoration: none; }

      @media (max-width: 768px) {
        .nav-links { display: none; }
        .hamburger-btn { display: flex; }
        .hero-title { font-size: 3rem; }
        .works-grid { grid-template-columns: 1fr; }
        .excerpts-grid { grid-template-columns: 1fr; }
        .reviews-grid { grid-template-columns: 1fr; }
        .about-box { flex-direction: column; }
        .gallery-grid { grid-template-columns: repeat(2, 1fr); }
        .works-list { position: static; transform: none; opacity: 1; visibility: visible; box-shadow: none; border: none; padding-top: 1rem; }
      }
    </style>
  </head>
  <body>

    <!-- لایه ورود -->
    <div class="intro-overlay" id="introOverlay">
      <img src="/mohaddeseh.jpg" alt="پس‌زمینه محدثه قدسی" class="intro-bg-img">
      <div class="intro-dark-layer"></div>
      <div class="intro-content">
        <p class="shahnameh-poem calligraphic" id="shahnamehText"></p>
        <button class="enter-btn" id="enterBtn">ورود به جهان روایت‌ها</button>
      </div>
    </div>

    <!-- لایت‌باکس گالری -->
    <div class="lightbox-overlay" id="lightbox">
      <span class="close-btn" id="closeLightbox">&times;</span>
      <div class="lightbox-content">
        <img src="" id="lightboxImg" alt="نقاشی">
      </div>
    </div>

    <!-- فایل صوتی تایپ -->
    <audio id="typing-sound" src="/typing.mp3" preload="auto"></audio>

    <!-- هدر -->
    <header class="glass-header">
      <div class="logo-text calligraphic" style="font-size: 1.5rem; color: var(--gold-dusty);">محدثه قدسی</div>
      <nav class="nav-links">
        <a href="#works">آثار</a>
        <a href="#gallery">گالری</a>
        <a href="#reviews">نظرات</a>
        <a href="#about">درباره من</a>
        <a href="#contact">تماس</a>
      </nav>
      <button class="hamburger-btn" id="hamburgerBtn">
        <span></span><span></span><span></span>
      </button>
    </header>

    <div class="mobile-menu" id="mobileMenu">
      <a href="#works">آثار</a>
      <a href="#gallery">گالری</a>
      <a href="#reviews">نظرات</a>
      <a href="#about">درباره من</a>
      <a href="#contact">تماس</a>
    </div>

    <!-- هیرو -->
    <section class="hero">
      <img src="/mohaddeseh.jpg" alt="پرتره محدثه قدسی" class="hero-img">
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1 id="typing-name" class="calligraphic hero-title"></h1>
        <div class="hero-sub">
          <div id="prof-1"></div>
          <div id="prof-2"></div>
          <div id="prof-3"></div>
        </div>
      </div>
    </section>

    <!-- آثار با منوی شناور -->
    <section id="works" class="section">
      <h2 class="section-title calligraphic reveal">جهان‌های روایی</h2>
      <div class="section-line reveal"></div>
      <div class="works-grid">
        
        <!-- داستان‌ها -->
        <div class="miniature-frame work-card reveal">
          <svg class="work-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
          </svg>
          <h3 class="work-title calligraphic">داستان‌ها</h3>
          <span class="work-genre">اجتماعی | عاشقانه</span>
          <div class="works-list">
            <a href="#" onclick="showSoon(event)">[عنوان داستان اول]</a>
            <a href="#" onclick="showSoon(event)">[عنوان داستان دوم]</a>
            <a href="#" onclick="showSoon(event)">[عنوان داستان سوم]</a>
          </div>
        </div>

        <!-- فیلمنامه‌ها -->
        <div class="miniature-frame work-card reveal">
          <svg class="work-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h1.5C5.25 19.5 6 18.75 6 18V5.25c0-.621-.504-1.125-1.125-1.125h-.75A1.125 1.125 0 0 0 3 5.25v13.125c0 .621.504 1.125 1.125 1.125Zm17.25 0a1.125 1.125 0 0 0 1.125-1.125V5.25c0-.621-.504-1.125-1.125-1.125h-.75A1.125 1.125 0 0 0 19.5 5.25v12.75c0 .621-.504 1.125-1.125 1.125h-15M12 3v15m-6-9h12" />
          </svg>
          <h3 class="work-title calligraphic">فیلمنامه‌ها</h3>
          <span class="work-genre">ماورایی | اجتماعی | وحشت</span>
          <div class="works-list">
            <a href="#" onclick="showSoon(event)">[عنوان فیلمنامه اول]</a>
            <a href="#" onclick="showSoon(event)">[عنوان فیلمنامه دوم]</a>
            <a href="#" onclick="showSoon(event)">[عنوان فیلمنامه سوم]</a>
          </div>
        </div>

        <!-- نقاشی‌ها -->
        <div class="miniature-frame work-card reveal">
          <svg class="work-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 15.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42" />
          </svg>
          <h3 class="work-title calligraphic">نقاشی‌ها</h3>
          <span class="work-genre">مینیاتور | تجسمی</span>
          <div class="works-list">
            <a href="#" onclick="showSoon(event)">[عنوان نقاشی اول]</a>
            <a href="#" onclick="showSoon(event)">[عنوان نقاشی دوم]</a>
            <a href="#" onclick="showSoon(event)">[عنوان نقاشی سوم]</a>
          </div>
        </div>

      </div>
    </section>

    <!-- دلنوشته‌ها -->
    <section id="excerpts" class="section">
      <h2 class="section-title calligraphic reveal">دلنوشته‌ها</h2>
      <div class="section-line reveal"></div>
      <div class="excerpts-grid">
        <div class="excerpt-card reveal">
          <div class="excerpt-quote">❝</div>
          <p class="excerpt-text">[برشی از دفترچه‌های روزانه محدثه قدسی در اینجا قرار خواهد گرفت.]</p>
          <a href="https://t.me/sofy_5827" target="_blank" class="excerpt-signature">مشاهده در کانال تلگرام ←</a>
        </div>
        <div class="excerpt-card reveal">
          <div class="excerpt-quote">❝</div>
          <p class="excerpt-text">[برشی از داستان‌های محدثه قدسی در اینجا قرار خواهد گرفت.]</p>
          <a href="https://t.me/sofy_5827" target="_blank" class="excerpt-signature">مشاهده در کانال تلگرام ←</a>
        </div>
      </div>
    </section>

    <!-- گالری مینیاتور -->
    <section id="gallery" class="section">
      <h2 class="section-title calligraphic reveal">گالری مینیاتور</h2>
      <div class="section-line reveal"></div>
      <div class="gallery-grid">
        <div class="gallery-item reveal" data-large="https://placehold.co/800x1000/0F2340/BC9A5A?text=Painting+1">
          <img src="https://placehold.co/200x200/0F2340/BC9A5A?text=1" alt="نقاشی ۱">
        </div>
        <div class="gallery-item reveal" data-large="https://placehold.co/800x1000/5A1422/E6DFD0?text=Painting+2">
          <img src="https://placehold.co/200x200/5A1422/E6DFD0?text=2" alt="نقاشی ۲">
        </div>
        <div class="gallery-item reveal" data-large="https://placehold.co/800x1000/0E5C45/E6DFD0?text=Painting+3">
          <img src="https://placehold.co/200x200/0E5C45/E6DFD0?text=3" alt="نقاشی ۳">
        </div>
        <div class="gallery-item reveal" data-large="https://placehold.co/800x1000/050E1A/BC9A5A?text=Painting+4">
          <img src="https://placehold.co/200x200/050E1A/BC9A5A?text=4" alt="نقاشی ۴">
        </div>
      </div>
    </section>

    <!-- پژواک خوانندگان (نظرات) -->
    <section id="reviews" class="section">
      <h2 class="section-title calligraphic reveal">پژواک خوانندگان</h2>
      <div class="section-line reveal"></div>
      <div class="reviews-grid">
        <div class="review-card reveal">
