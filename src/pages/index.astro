<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>محدثه قدسی | روایتگر سکوت‌ها</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100;300;400;700;900&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --navy-deep: #030710;
        --navy-primary: #081225;
        --navy-card: #0D1A2E;
        --burgundy: #641F35;
        --burgundy-glow: #9A2D4E;
        --emerald: #0D9488;
        --emerald-glow: #15A199;
        --gold-accent: #C9A95D;
        --ivory: #E8E2D8;
        --text-muted: #5C6B7A;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Vazirmatn', sans-serif;
        background-color: var(--navy-deep);
        color: var(--ivory);
        line-height: 2;
        overflow-x: hidden;
      }

      /* هدر شناور شیشه‌ای */
      .glass-header {
        position: fixed; top: 1.5rem; left: 50%; transform: translateX(-50%);
        z-index: 100; padding: 1rem 2.5rem;
        background: rgba(10, 20, 36, 0.6); backdrop-filter: blur(15px);
        border: 1px solid rgba(201, 169, 93, 0.2); border-radius: 50px;
        display: flex; align-items: center; justify-content: space-between; gap: 3rem;
        width: calc(100% - 4rem); max-width: 900px;
      }
      .logo-text { font-weight: 900; font-size: 1.2rem; color: var(--ivory); letter-spacing: 1px; }
      .nav-links { display: flex; gap: 2rem; }
      .nav-links a { color: var(--text-muted); font-size: 0.9rem; text-decoration: none; transition: color 0.3s; }
      .nav-links a:hover { color: var(--gold-accent); }

      /* آیکون همبرگر */
      .hamburger-btn {
        display: none; cursor: pointer; background: none; border: none; z-index: 110;
        width: 30px; height: 30px; position: relative;
      }
      .hamburger-btn span {
        display: block; position: absolute; height: 2px; width: 100%;
        background: var(--ivory); border-radius: 2px; transition: all 0.4s ease;
      }
      .hamburger-btn span:nth-child(1) { top: 8px; }
      .hamburger-btn span:nth-child(2) { top: 15px; }
      .hamburger-btn span:nth-child(3) { top: 22px; }
      /* تغییر ضربدر هنگام باز شدن */
      .hamburger-btn.active span:nth-child(1) { top: 15px; transform: rotate(45deg); background: var(--burgundy-glow); }
      .hamburger-btn.active span:nth-child(2) { opacity: 0; }
      .hamburger-btn.active span:nth-child(3) { top: 15px; transform: rotate(-45deg); background: var(--burgundy-glow); }

      /* منوی تمام‌صفحه موبایل */
      .mobile-menu-overlay {
        position: fixed; top: 0; right: 0; width: 100%; height: 100vh;
        background: rgba(3, 7, 16, 0.98); backdrop-filter: blur(20px);
        z-index: 105; display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 2rem; opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
      }
      .mobile-menu-overlay.open { opacity: 1; pointer-events: all; }
      .mobile-menu-overlay a {
        color: var(--ivory); font-size: 2rem; font-weight: 300; text-decoration: none;
        letter-spacing: 2px; transition: color 0.3s;
      }
      .mobile-menu-overlay a:hover { color: var(--burgundy-glow); }

      /* بخش هیرو تمام‌صفحه با پرتره */
      .hero-fullscreen {
        position: relative; height: 100vh; display: flex; align-items: center;
        justify-content: flex-start; overflow: hidden;
      }
      .hero-bg-img {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        object-fit: cover; object-position: center top; z-index: 1;
      }
      .hero-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: linear-gradient(90deg, rgba(3, 7, 16, 0.95) 0%, rgba(3, 7, 16, 0.7) 40%, rgba(3, 7, 16, 0.1) 100%);
        z-index: 2;
      }
      .hero-content { position: relative; z-index: 3; padding: 0 4rem; max-width: 800px; }
      .hero-title {
        font-size: 2.2rem; font-weight: 700; line-height: 1.2; margin-bottom: 1.5rem;
        color: var(--ivory); border-right: 2px solid var(--gold-accent);
        padding-right: 1rem; white-space: nowrap; overflow: hidden; min-height: 40px;
      }
      .hero-title::after { content: '|'; color: var(--gold-accent); animation: blink 0.8s infinite; }
      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
      .profession-list { display: flex; flex-direction: column; gap: 0.3rem; }
      .profession-item {
        font-size: 1.1rem; font-weight: 300; color: var(--text-muted);
        min-height: 1.5rem; white-space: nowrap; overflow: hidden;
      }

      /* بخش‌های عمومی سایت */
      .section { padding: 8rem 4rem; position: relative; z-index: 2; }
      .section-header { margin-bottom: 5rem; }
      .section-title {
        font-size: 3.5rem; font-weight: 900; color: var(--ivory); margin-bottom: 1rem;
        letter-spacing: -1px;
      }
      .section-line { width: 60px; height: 3px; background: var(--gold-accent); box-shadow: 0 0 10px var(--gold-accent); }

      /* کارت‌های ماورایی */
      .mystic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
      .mystic-card {
        background: rgba(13, 26, 46, 0.5); backdrop-filter: blur(10px);
        padding: 3rem 2rem; position: relative; overflow: hidden;
        border: 1px solid rgba(255,255,255,0.03);
        transition: transform 0.4s ease, border-color 0.4s ease;
      }
      .mystic-card:hover { border-color: rgba(201, 169, 93, 0.2); transform: translateY(-10px); }
      .mystic-card::before {
        content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px;
        background: linear-gradient(90deg, transparent, var(--burgundy-glow), transparent);
        opacity: 0; transition: opacity 0.4s;
      }
      .mystic-card:hover::before { opacity: 1; }
      .card-icon { font-size: 2.5rem; margin-bottom: 1.5rem; display: block; opacity: 0.8; }
      .card-title { font-size: 1.8rem; color: var(--ivory); margin-bottom: 0.5rem; font-weight: 700; }
      .card-genre { color: var(--gold-accent); font-size: 0.8rem; margin-bottom: 1.5rem; display: block; letter-spacing: 1px; }
      .card-desc { color: var(--text-muted); font-size: 1rem; font-weight: 300; }

      /* کلیدهای هندسی و درخشان */
      .btn-sharp {
        padding: 1rem 2.5rem; font-size: 0.9rem; font-weight: 700; letter-spacing: 1px;
        background: transparent; color: var(--ivory); text-decoration: none;
        clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
        transition: all 0.4s ease; position: relative; display: inline-block;
        border: 1px solid var(--navy-card);
      }
      .btn-gold-glow {
        background: linear-gradient(45deg, var(--burgundy), var(--burgundy-glow));
        border: none; box-shadow: 0 0 15px rgba(100, 31, 53, 0.4);
      }
      .btn-emerald-ghost { border: 1px solid var(--emerald); color: var(--emerald-glow); }
      .btn-emerald-ghost:hover { background: rgba(13, 148, 136, 0.1); box-shadow: 0 0 20px rgba(13, 148, 136, 0.3); }

      /* بخش کتاب‌ها */
      .books-showcase { display: flex; justify-content: flex-start; gap: 4rem; flex-wrap: wrap; }
      .book-item {
        width: 220px; background: rgba(8, 18, 37, 0.8); padding: 1.5rem;
        position: relative; border-top: 1px solid rgba(201, 169, 93, 0.1);
        border-bottom: 1px solid rgba(201, 169, 93, 0.1); transition: transform 0.3s;
      }
      .book-item:hover { transform: translateY(-5px); }
      .book-cover-placeholder { 
        width: 100%; height: 280px; background: var(--navy-deep); margin-bottom: 1.5rem; 
        display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 0.8rem;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
      }
      .book-title { font-size: 1.2rem; color: var(--ivory); margin-bottom: 0.5rem; }
      .book-link { color: var(--emerald-glow); font-size: 0.8rem; text-decoration: none; letter-spacing: 1px; }

      /* بخش نظرات */
      .reviews-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
      .review-card {
        background: linear-gradient(145deg, rgba(13,26,46,0.6), rgba(3,7,16,0.8));
        padding: 2.5rem; position: relative; border: 1px solid rgba(201, 169, 93, 0.05);
        border-radius: 12px;
      }
      .quote-icon { font-size: 3rem; color: var(--burgundy); opacity: 0.3; position: absolute; top: 1rem; right: 1.5rem; }
      .review-text { color: var(--ivory); font-size: 1rem; font-weight: 300; margin-bottom: 1.5rem; position: relative; z-index: 2; }
      .reviewer-info { display: flex; align-items: center; gap: 1rem; }
      .reviewer-avatar { width: 50px; height: 50px; border-radius: 50%; background: var(--navy-deep); border: 1px solid var(--gold-accent); display: flex; align-items: center; justify-content: center; color: var(--gold-accent); font-size: 0.8rem; }
      .reviewer-name { color: var(--ivory); font-size: 0.9rem; font-weight: 700; }
      .reviewer-role { color: var(--text-muted); font-size: 0.8rem; }

      /* درباره من */
      .about-box {
        background: linear-gradient(145deg, rgba(13,26,46,0.6), rgba(3,7,16,0.8));
        padding: 4rem; display: flex; gap: 4rem; align-items: center;
        border: 1px solid rgba(201, 169, 93, 0.05);
      }
      .about-text p { margin-bottom: 1.5rem; font-size: 1.2rem; color: var(--ivory); font-weight: 300; }

      /* فوتر */
      footer { background: var(--navy-primary); margin-top: 4rem; padding: 5rem 4rem 2rem; border-top: 1px solid rgba(201, 169, 93, 0.05); }
      .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 3rem; margin-bottom: 3rem; }
      .footer-link { color: var(--text-muted); display: block; margin-bottom: 0.8rem; font-size: 0.9rem; text-decoration: none; transition: color 0.3s; }
      .footer-link:hover { color: var(--burgundy-glow); }
      .copyright { text-align: center; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.03); color: var(--text-muted); font-size: 0.8rem; letter-spacing: 1px; }

      @media (max-width: 768px) {
        .glass-header { width: calc(100% - 2rem); padding: 1rem 1.5rem; gap: 1rem; }
        .nav-links { display: none; }
        .hamburger-btn { display: block; } /* نمایش همبرگر در موبایل */
        
        .hero-content { padding: 0 2rem; }
        .hero-title { font-size: 1.8rem; }
        .profession-item { font-size: 1rem; }
        .section { padding: 4rem 2rem; }
        .section-title { font-size: 2.5rem; }
        .mystic-grid { grid-template-columns: 1fr; }
        .reviews-grid { grid-template-columns: 1fr; }
        .about-box { flex-direction: column; padding: 2rem; text-align: center; }
        .footer-grid { grid-template-columns: 1fr; text-align: center; gap: 2rem; }
        footer { padding: 3rem 2rem 2rem; }
      }
    </style>
  </head>
