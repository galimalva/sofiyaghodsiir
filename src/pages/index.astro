      ];
      
      const sound = document.getElementById("typing-sound");
      let hasStarted = false;

      function playSound() {
        if (sound) {
          sound.currentTime = 0;
          sound.play().catch(e => {});
        }
      }

      function startTyping() {
        if (hasStarted) return;
        hasStarted = true;

        let currentTextIndex = 0;
        let currentCharIndex = 0;

        function typeNextChar() {
          if (currentTextIndex >= textsToType.length) return;

          const currentItem = textsToType[currentTextIndex];
          const el = document.getElementById(currentItem.id);

          if (currentCharIndex < currentItem.text.length) {
            el.innerHTML += currentItem.text.charAt(currentCharIndex);
            playSound();
            currentCharIndex++;
            setTimeout(typeNextChar, 150);
          } else {
            currentTextIndex++;
            currentCharIndex = 0;
            setTimeout(typeNextChar, 600);
          }
        }
        typeNextChar();
      }

      document.body.addEventListener('click', startTyping);
      
      setTimeout(() => {
        if (!hasStarted) {
          let currentTextIndex = 0;
          let currentCharIndex = 0;
          
          function typeSilent() {
            if (currentTextIndex >= textsToType.length) return;
            const currentItem = textsToType[currentTextIndex];
            const el = document.getElementById(currentItem.id);
            
            if (currentCharIndex < currentItem.text.length) {
              el.innerHTML += currentItem.text.charAt(currentCharIndex);
              currentCharIndex++;
              setTimeout(typeSilent, 150);
            } else {
              currentTextIndex++;
              currentCharIndex = 0;
              setTimeout(typeSilent, 600);
            }
          }
          typeSilent();
          hasStarted = true;
        }
      }, 1500);
    </script>

    <!-- اسکریپت منوی موبایل -->
    <script is:inline>
      const hamburger = document.getElementById('hamburgerBtn');
      const mobileMenu = document.getElementById('mobileMenu');

      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        mobileMenu.classList.toggle('open');
      });

      // بستن منو وقتی روی یکی از لینک‌ها کلیک می‌شود
      document.querySelectorAll('.mobile-menu-overlay a').forEach(link => {
        link.addEventListener('click', () => {
          hamburger.classList.remove('active');
          mobileMenu.classList.remove('open');
        });
      });
    </script>

  </body>
</html>