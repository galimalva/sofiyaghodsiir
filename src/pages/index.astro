---
// وب‌سایت اختصاصی محدثه قدسی - بسته امضا (تایپ، آیکون‌های هنری و روایت)
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>محدثه قدسی | روایتگر مینیاتور و قصه</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gulzar&family=Vazirmatn:wght@300;400;700;900&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --navy-deep: #050E1A; /* سرمه‌ای تیره */
        --navy-primary: #0A1828;
        --navy-card: #0F2340;
        --burgundy: #5A1422; /* زرشکی عمیق */
        --burgundy-glow: #8A2D48;
        --emerald: #0E5C45; /* سبز عیونی */
        --emerald-glow: #15A199;
        --gold-dusty: #BC9A5A; /* طلایی دوداری */
        --ivory: #E6DFD0;
        --text-muted: #8A8B92;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Vazirmatn', sans-serif;
        background-color: var(--navy-deep);
        background-image: radial-gradient(circle at 10% 10%, rgba(90, 20, 34, 0.15) 0%, transparent 40%), radial-gradient(circle at 90% 90%, rgba(14, 92, 69, 0.1) 0%, transparent 40%);
        color: var(--ivory);
        line-height: 2;
        overflow-x: hidden;
      }

      /* فونت کالیگرافیک برای تیترها */
      .calligraphic { font-family: 'Gulzar', serif; font-weight: 400; }

      /* لایه ورود (Intro) */
      .intro-overlay {
        position: fixed; inset: 0; z-index: 1000; background: var(--navy-deep);
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rem;
        transition: opacity 1s ease, visibility 1s ease;
      }
      .intro-overlay.hidden { opacity: 0; visibility: hidden; }
      .miniature-svg { width: 100px; height: 100px; opacity: 0.8; animation: pulseGold 4s infinite ease-in-out; }
      @keyframes pulseGold { 0%, 100% { filter: drop-shadow(0 0 5px var(--gold-dusty)); } 50% { filter: drop-shadow(0 0 15px var(--gold-dusty)); } }
      .shahnameh-poem { max-width: 600px; text-align: center; font-size: 1.8rem; color: var(--ivory); line-height: 1.8; }
      .enter-btn { padding: 1rem 3rem; background: transparent; border: 1px solid var(--gold-dusty); color: var(--gold-dusty); font-family: 'Vazirmatn'; font-size: 1rem; cursor: pointer; transition: all 0.4s; }
      .enter-btn:hover { background: rgba(188, 154, 90, 0.1); box-shadow: 0 0 20px rgba(188, 154, 90, 0.3); }

      /* هدر شناور */
      .glass-header {
        position: fixed; top: 1.5rem; left: 50%; transform: translateX(-50%); z-index: 100; padding: 1rem 2.5rem;
        background: rgba(10, 24, 40, 0.7); backdrop-filter: blur(15px);
        border: 1px solid rgba(188, 154, 90, 0.2); border-radius: 4px; 
        display: flex; align-items: center; justify-content: space-between; gap: 3rem; width: calc(100% - 4rem); max-width: 900px;
      }
      .nav-links { display: flex; gap: 2rem; }
      .nav-links a { color: var(--text-muted); font-size: 0.9rem; text-decoration: none; transition: color 0.3s; position: relative; }
      .nav-links a:hover { color: var(--burgundy-glow); }
      .nav-links a::after { content: ''; position: absolute; bottom: -5px; right: 0; width: 0; height: 1px; background: var(--gold-dusty); transition: width 0.3s; }
      .nav-links a:hover::after { width: 100%; }

      /* هیرو */
      .hero { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 0 2rem; position: relative; }
      .hero-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.4; z-index: 1; }
      .hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, var(--navy-deep) 0%, transparent 40%, var(--navy-deep) 100%); z-index: 2; }
      .hero-content { position: relative; z-index: 3; text-align: center; }
      .hero-title { font-size: 5rem; margin-bottom: 1rem; background: linear-gradient(180deg, var(--ivory), var(--gold-dusty)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; border-right: 2px solid var(--gold-dusty); padding-right: 1rem; white-space: nowrap; overflow: hidden; min-height: 80px; display: inline-block; }
      .hero-title::after { content: '|'; color: var(--gold-dusty); animation: blink 0.8s infinite; }
      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
      .hero-sub { display: flex; flex-direction: column; gap: 0.3rem; min-height: 5rem; }
      .hero-sub div { letter-spacing: 5px; color: var(--burgundy-glow); font-size: 1rem; white-space: nowrap; overflow: hidden; min-height: 1.5rem; }

      /* بخش عمومی */
      .section { padding: 6rem 2rem; position: relative; max-width: 1200px; margin: 0 auto; }
      .section-title { font-size: 3.5rem; text-align: center; margin-bottom: 1rem; color: var(--ivory); }
      .section-line { width: 80px; height: 2px; margin: 0 auto 4rem; background: var(--gold-dusty); position: relative; }
      .section-line::before, .section-line::after { content: '✦'; position: absolute; top: -12px; color: var(--gold-dusty); font-size: 0.8rem; }
      .section-line::before { right: -20px; }
      .section-line::after { left: -20px; }

      /* قاب مینیاتوری دور کارت‌ها */
      .miniature-frame { position: relative; background: rgba(15, 35, 64, 0.6); border: 1px solid rgba(188, 154, 90, 0.1); transition: transform 0.4s; }
      .miniature-frame:hover { transform: translateY(-10px); }
      .miniature-frame::before { content: ''; position: absolute; top: 10px; right: 10px; width: 30px; height: 30px; border-top: 2px solid var(--gold-dusty); border-right: 2px solid var(--gold-dusty); transition: 0.3s; }
      .miniature-frame::after { content: ''; position: absolute; bottom: 10px; left: 10px; width: 30px; height: 30px; border-bottom: 2px solid var(--gold-dusty); border-left: 2px solid var(--gold-dusty); transition: 0.3s; }
      .miniature-frame:hover::before, .miniature-frame:hover::after { width: 40px; height: 40px; }

      /* آثار */
      .works-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
      .work-card { padding: 3rem 2rem; text-align: center; }
      .work-icon-svg { width: 48px; height: 48px; color: var(--gold-dusty); margin: 0 auto 1.5rem; display: block; }
      .work-title { font-size: 1.8rem; color: var(--ivory); margin-bottom: 0.5rem; }
      .work-genre { color: var(--emerald-glow); font-size: 0.85rem; letter-spacing: 1px; }

      /* درباره من */
      .about-box { display: flex; align-items: center; gap: 4rem; }
      .about-text { flex: 1; }
      .about-img { flex: 0 0 300px; height: 400px; border: 2px solid var(--gold-dusty); padding: 10px; position: relative; }
      .about-img img { width: 100%; height: 100%; object-fit: cover; }

      /* گالری */
      .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
      .gallery-item { aspect-ratio: 1; background: var(--navy-card); border: 1px solid rgba(188, 154, 90, 0.1); display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 0.8rem; cursor: pointer; transition: 0.3s; }
      .gallery-item:hover { border-color: var(--burgundy-glow); box-shadow: 0 0 15px rgba(90, 20, 34, 0.3); }

      /* انیمیشن Reveal */
      .reveal { opacity: 0; transform: translateY(40px); transition: all 1s ease; }
      .reveal.visible { opacity: 1; transform: translateY(0); }

      /* فوتر */
      footer { margin-top: 4rem; padding: 3rem 2rem; border-top: 1px solid rgba(188, 154, 90, 0.1); text-align: center; }
      
      /* آیکون همبرگر موبایل */
      .hamburger-btn { display: none; background: none; border: none; cursor: pointer; flex-direction: column; gap: 5px; }
      .hamburger-btn span { width: 25px; height: 2px; background: var(--ivory); }
      .mobile-menu { position: fixed; inset: 0; background: var(--navy-deep); z-index: 90; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rem; opacity: 0; pointer-events: none; transition: 0.4s; }
      .mobile-menu.open { opacity: 1; pointer-events: all; }
      .mobile-menu a { color: var(--ivory); font-size: 1.5rem; text-decoration: none; }

      @media (max-width: 768px) {
        .nav-links { display: none; }
        .hamburger-btn { display: flex; }
        .hero-title { font-size: 3rem; }
        .works-grid { grid-template-columns: 1fr; }
        .about-box { flex-direction: column; }
        .gallery-grid { grid-template-columns: repeat(2, 1fr); }
      }
    </style>
  </head>
  <body>

    <!-- لایه ورود با شاهنامه -->
    <div class="intro-overlay" id="introOverlay">
      <svg class="miniature-svg" viewBox="0 0 100 100" fill="none" stroke="var(--gold-dusty)" stroke-width="1">
        <circle cx="50" cy="50" r="40" />
        <circle cx="50" cy="50" r="30" />
        <path d="M50 10 L60 40 L90 50 L60 60 L50 90 L40 60 L10 50 L40 40 Z" />
      </svg>
      <p class="shahnameh-poem calligraphic" id="shahnamehText"></p>
      <button class="enter-btn" id="enterBtn">ورود به جهان روایت‌ها</button>
    </div>

    <!-- فایل‌های صوتی -->
    <audio id="bg-music" src="/music.mp3" loop></audio>
    <audio id="typing-sound" src="/typing.mp3" preload="auto"></audio>

    <!-- هدر -->
    <header class="glass-header">
      <div class="logo-text calligraphic" style="font-size: 1.5rem; color: var(--gold-dusty);">محدثه قدسی</div>
      <nav class="nav-links">
        <a href="#works">آثار</a>
        <a href="#gallery">گالری</a>
        <a href="#about">درباره من</a>
        <a href="#contact">تماس</a>
      </nav>
      <button class="hamburger-btn" id="hamburgerBtn">
        <span></span><span></span><span></span>
      </button>
    </header>

    <div class="mobile-menu" id="mobileMenu">
      <a href="#works">آثار</a>
      <a href="#gallery">گالری</a>
      <a href="#about">درباره من</a>
      <a href="#contact">تماس</a>
    </div>

    <!-- هیرو -->
    <section class="hero">
      <img src="/mohaddeseh.jpg" alt="پرتره محدثه قدسی" class="hero-img">
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1 id="typing-name" class="calligraphic hero-title"></h1>
        <div class="hero-sub">
          <div id="prof-1"></div>
          <div id="prof-2"></div>
          <div id="prof-3"></div>
        </div>
      </div>
    </section>

    <!-- آثار -->
    <section id="works" class="section">
      <h2 class="section-title calligraphic reveal">جهان‌های روایی</h2>
      <div class="section-line reveal"></div>
      <div class="works-grid">
        <!-- داستان‌ها -->
        <div class="miniature-frame work-card reveal">
          <svg class="work-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
          </svg>
          <h3 class="work-title calligraphic">داستان‌ها</h3>
          <p class="work-genre">اجتماعی | عاشقانه</p>
        </div>
        <!-- فیلمنامه‌ها -->
        <div class="miniature-frame work-card reveal">
          <svg class="work-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h1.5C5.25 19.5 6 18.75 6 18V5.25c0-.621-.504-1.125-1.125-1.125h-.75A1.125 1.125 0 0 0 3 5.25v13.125c0 .621.504 1.125 1.125 1.125Zm17.25 0a1.125 1.125 0 0 0 1.125-1.125V5.25c0-.621-.504-1.125-1.125-1.125h-.75A1.125 1.125 0 0 0 19.5 5.25v12.75c0 .621-.504 1.125-1.125 1.125h-15M12 3v15m-6-9h12" />
          </svg>
          <h3 class="work-title calligraphic">فیلمنامه‌ها</h3>
          <p class="work-genre">ماورایی | اجتماعی | وحشت</p>
        </div>
        <!-- نقاشی‌ها -->
        <div class="miniature-frame work-card reveal">
          <svg class="work-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 15.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42" />
          </svg>
          <h3 class="work-title calligraphic">نقاشی‌ها</h3>
          <p class="work-genre">مینیاتور | تجسمی</p>
        </div>
      </div>
    </section>

    <!-- گالری مینیاتور -->
    <section id="gallery" class="section">
      <h2 class="section-title calligraphic reveal">گالری مینیاتور</h2>
      <div class="section-line reveal"></div>
      <div class="gallery-grid">
        <div class="gallery-item reveal">تصویر ۱</div>
        <div class="gallery-item reveal">تصویر ۲</div>
        <div class="gallery-item reveal">تصویر ۳</div>
        <div class="gallery-item reveal">تصویر ۴</div>
      </div>
    </section>

    <!-- درباره من -->
    <section id="about" class="section">
      <div class="about-box">
        <div class="about-img reveal">
          <img src="/mohaddeseh.jpg" alt="محدثه قدسی">
        </div>
        <div class="about-text reveal">
          <h2 class="calligraphic" style="font-size: 2.5rem; margin-bottom: 1.5rem; color: var(--burgundy-glow);">از زبان خودم...</h2>
          <p style="font-size: 1.2rem; color: var(--ivory); font-weight: 300;">من قصه‌ها را با کلمات می‌نویسم، با فیلمنامه به آن‌ها جان می‌دهم و با نقاشی، احساساتی را به تصویر می‌کشم که شاید هیچ واژه‌ای برایشان کافی نباشد.</p>
          <p style="font-size: 1.2rem; color: var(--text-muted); font-weight: 300;">نوشتن و نقاشی برای من فقط خلق کردن نیست؛ راهی‌ست برای دیدن جهان از زاویه‌ای دیگر و روایت چیزهایی که در سکوتِ ذهنم شکل می‌گیرند.</p>
        </div>
      </div>
    </section>

    <!-- تماس -->
    <section id="contact" class="section">
      <h2 class="section-title calligraphic reveal">ارتباط با من</h2>
      <div class="section-line reveal"></div>
      <div style="text-align: center;">
        <a href="https://instagram.com/ghodsi_58_27" target="_blank" class="enter-btn reveal" style="display: inline-block; text-decoration: none; margin: 1rem;">اینستاگرام</a>
        <a href="https://t.me/sofy_5827" target="_blank" class="enter-btn reveal" style="display: inline-block; text-decoration: none; margin: 1rem;">تلگرام</a>
      </div>
    </section>

    <footer>
      <p class="calligraphic" style="color: var(--gold-dusty); font-size: 1.2rem;">محدثه قدسی</p>
      <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem;">© تمامی حقوق محفوظ است.</p>
    </footer>

    <script is:inline>
      // اشعار شاهنامه
      const poems = [
        "به نام خداوند جان و خرد<br>کزین برتر اندیشه برنگذرد",
        "توانا بود هر که دانا بود<br>دانش ز گنج برتر اندر خرد",
        "نه یاد کنم چون خبر از کس شنیدم<br>که گشته ست معلوم مگو کس ندیدم",
        "چو ایران نباشد تن من مبد<br>زنده در این خاک که دل زنده بود"
      ];
      document.getElementById("shahnamehText").innerHTML = poems[Math.floor(Math.random() * poems.length)];

      // ورود به سایت و پخش موسیقی
      const intro = document.getElementById("introOverlay");
      const music = document.getElementById("bg-music");
      const enterBtn = document.getElementById("enterBtn");

      // متن‌های تایپ شونده
      const textsToType = [
        { id: "typing-name", text: "محدثه قدسی" },
        { id: "prof-1", text: "فیلمنامه‌نویس" },
        { id: "prof-2", text: "داستان‌نویس" },
        { id: "prof-3", text: "نقاش" }
      ];
      const typingSound = document.getElementById("typing-sound");
      let hasTyped = false;

      function startTyping() {
        if (hasTyped) return;
        hasTyped = true;

        let currentTextIndex = 0;
        let currentCharIndex = 0;

        function playSound() {
          if (typingSound) {
            typingSound.currentTime = 0;
            typingSound.play().catch(e => {});
          }
        }

        function typeNextChar() {
          if (currentTextIndex >= textsToType.length) return;

          const currentItem = textsToType[currentTextIndex];
          const el = document.getElementById(currentItem.id);

          if (currentCharIndex < currentItem.text.length) {
            el.innerHTML += currentItem.text.charAt(currentCharIndex);
            playSound();
            currentCharIndex++;
            setTimeout(typeNextChar, 150);
          } else {
            currentTextIndex++;
            currentCharIndex = 0;
            setTimeout(typeNextChar, 600);
          }
        }
        typeNextChar();
      }

      enterBtn.addEventListener("click", () => {
        intro.classList.add("hidden");
        music.play().catch(e => {}); // پخش موسیقی پس از کلیک کاربر
        setTimeout(startTyping, 1000); // شروع افکت تایپ پس از محو شدن لایه ورود
      });

      // افکت Reveal هنگام اسکرول
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.reveal').forEach(el => {
        observer.observe(el);
      });

      // منوی موبایل
      const hamburger = document.getElementById('hamburgerBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        mobileMenu.classList.toggle('open');
      });
      document.querySelectorAll('.mobile-menu a').forEach(link => {
        link.addEventListener('click', () => {
          hamburger.classList.remove('active');
          mobileMenu.classList.remove('open');
        });
      });
    </script>
  </body>
</html>