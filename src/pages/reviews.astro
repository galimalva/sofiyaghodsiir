---
import Layout from '../layouts/Layout.astro';
---

<Layout title="پژواک خوانندگان | محدثه قدسی" active="reviews">
  <section id="reviews" class="section">
    <h2 class="section-title calligraphic reveal">پژواک خوانندگان</h2>
    <div class="section-line reveal"></div>
    <div class="reviews-grid">
      <div class="review-card reveal">
        <p class="review-text">[متن نظر خواننده در اینجا قرار خواهد گرفت.]</p>
        <div class="reviewer-info">
          <div class="reviewer-avatar">ن</div>
          <div>
            <div class="reviewer-name calligraphic">[نام خواننده]</div>
            <div class="reviewer-role">[سمت یا حرفه]</div>
          </div>
        </div>
      </div>
      <div class="review-card reveal">
        <p class="review-text">[متن نظر خواننده دوم در اینجا قرار خواهد گرفت.]</p>
        <div class="reviewer-info">
          <div class="reviewer-avatar">ن</div>
          <div>
            <div class="reviewer-name calligraphic">[نام خواننده]</div>
            <div class="reviewer-role">[سمت یا حرفه]</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>